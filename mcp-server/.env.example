# Local run: cp .env.example .env, fill in, then
#   set -a && source .env && set +a && uv run uvicorn server:create_app --factory --port 8000
HUB_URL=https://hub.apps.sbx.example.com/hub
HUB_AUTH_MODE=client_credentials
# Service Account ID and Secret from Hub (the Client Assertion is not needed)
HUB_CLIENT_ID=
HUB_CLIENT_SECRET=
# Bootstrap alternative: HUB_AUTH_MODE=static with a bearer token copied from Altair
# HUB_STATIC_TOKEN=
MCP_API_KEY=change-me
CA_BUNDLE=
LOG_LEVEL=INFO
